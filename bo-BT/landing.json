  "landing.bridge.first.line1": "སྒྲུང་རྣམས་འཇིག་རྟེན་དུ་འགྱུར།",
  "landing.bridge.first.line2": "འཇིག་རྟེན་རྣམས་སྒྲུང་དུ་འགྱུར།",
  "landing.bridge.first.body": "འཇིག་རྟེན་ཞེས་པ་མཉམ་སྤྱོད་ཀྱི་འཇིག་རྟེན་ཞིག་ཡིན། དེའི་ཤེས་བྱ་མཛོད་དང་། སྒྲུང་དང་རི་མོའི་སྒྲུང་དང་སྒྲ་དཔེ། ཚོགས་གླེང་དང་ཕ་རོལ་པ་རྣམས་ཡོད། Literary Universe གིས་དེ་ཐམས་ཅད་ཡིག་རྩོམ་དང་པོ་ནས་གསོན་པོའི་དད་པ་ཅན་གྱི་ཚོགས་པའི་བར་ས་གཅིག་ཏུ་བསྡུས་ཡོད།",
