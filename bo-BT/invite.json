  "invite.author.ribbon2": "ཀློག་མཁན་གསར་པ་ལ་སླེབས།",
  "invite.author.ribbon3": "བརྒྱ་ཆ་༧༠ ནས་༩༠ འཛིན།",
  "invite.author.ribbon4": "བཀག་འཛིན་མེད།",
  "invite.author.ribbon5": "ཚོང་འདོན་གྲངས་ཐོ་ཁ་ཕྱེས།",
  "invite.author.ribbon6": "EPUB ལ་ཕྱིར་འདོན།",
  "invite.author.title1": "ཁྱེད་ཀྱིས་པར་དུ་བསྐྲུན་ཟིན་པའི་",
  "invite.author.title2": "དཔེ་ཆ་དེ་དག་",
  "invite.author.title3": "ཀློག་མཁན་གསར་པའི་མདུན་དུ་ཁྱེར།",
  "invite.author.intro": "Literary Universe ནང་ཀློག་མཁན་གྱིས་ཁྱེད་ཀྱི་དཔེ་ཆའི་རྒྱབ་ཀྱི་འཇིག་རྟེན་ཞིབ་འཇུག་བྱེད་ཐུབ་ཅིང་། ཁྱེད་ཀྱིས་ཚོང་འདོན་རེ་རེའི་ནང་ནས་བརྒྱ་ཆ་༧༠ ནས་༩༠ བར་འཛིན།",
