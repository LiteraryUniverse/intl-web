  "invite.writer.feature1Body": "ཁྱེད་ཀྱི་འཇིག་རྟེན་གྱི་ཤེས་བྱ་མཛོད་ནང་མི་སྣ། ས་ཆ། སྲོག་ཆགས་དང་ལོ་རྒྱུས་ཉར། དེའི་སྟེང་ནས་ཁྱེད་ཀྱི་སྒྲུང་འབྲི།",
  "invite.writer.feature2Title": "ཁྱེད་ཀྱི་རུ་ཁག་ཁྱེར།",
  "invite.writer.feature2Body": "སྒྲུང་རེ་རེ་ལ་ཡང་ན་འཇིག་རྟེན་ཧྲིལ་པོ་ལ་བརྟ་དྲེར། རྩོམ་པ་པོ་མཉམ་ལས་པ་དང་སྒྱུར་མཁན་རྣམས་སྣོན།",
  "invite.writer.feature3Title": "ཁྱེད་ཀྱི་ཀློག་མཁན་དང་གླེང་མོལ་བྱོས།",
  "invite.writer.feature3Body": "ཟིན་བྲིས། ཚོགས་གླེང་དང་ཁྱེད་ཀྱི་འབབ་རྒྱུན་གྱིས་ཁྱེད་ཀྱི་འཇིག་རྟེན་ལ་རྗེས་འབྲང་བྱེད་པའི་མི་རྣམས་དང་ཁྱེད་སྦྲེལ།",
  "invite.writer.feature4Title": "ཁྱེད་ཀྱི་ལས་ཀའི་ཆེད་དུ་དངུལ་ཐོབ།",
  "invite.writer.feature4Body": "ལེའུ། དཔེ་ཆ་ཧྲིལ་པོ་ཡང་ན་ཐུམ་སྒྲིལ་ཚོང་འདོན་བྱོས། ཡང་ན་ཕ་རོལ་པའི་ཚོགས་ཤིག་འགོ་འཛུགས། ཁྱད་པར་བའི་ཆོག་མཆན་འོག་སྟེགས་བུའི་འགྲོ་གྲོན་བརྒྱ་ཆ་༡༠ དང་། ཁྱད་པར་མེད་པའི་ཆོག་མཆན་འོག་བརྒྱ་ཆ་༣༠ ཡིན།",
