  "landing.faq.title.lead": "ཐད་ཀར་ལན།",
  "landing.faq.title.em": "ཐོ་འགོད་མ་བྱས་གོང་།",
  "landing.faq.free.q": "རིན་མེད་ཡིན་ནམ།",
  "landing.faq.free.a": "ཡིན། རིན་མེད་འཆར་གཞིས་འཇིག་རྟེན་དང་སྒྲུང་བསྐྲུན། སྒྱུར་རྩོམ། ཕ་རོལ་པའི་སྒྲུང་འབྲི། ཕ་རོལ་པའི་ཚོགས་འཛིན་དང་ཁྱེད་ཀྱི་ལས་ཀ་ཚོང་འདོན་བྱེད་ཐུབ། ཤེས་བྱ་མཛོད་ཀྱི་ནང་དོན་གྲངས་ལྟ་བུའི་ཚད་བཀག་ཡོད། རིན་ཐོབ་འཆར་གཞིས་ཤེས་བྱ་མཛོད་ཀྱི་བར་སྟོང་མང་བ། ཟིན་བྲིས། ཚོགས་གླེང་དང་སྔོན་ཐོན་གྱི་ཐོ་གཞུང་སྣོན།",
  "landing.faq.rights.q": "ངས་དབང་ཆ་ཉར་ཐུབ་གས།",
  "landing.faq.rights.a": "ཐུབ། ཁྱེད་ཀྱིས་པར་དབང་ཉར་ནས་ལས་ཀ་རེ་རེར་ཆོག་མཆན་འདེམས། ཚོང་འདོན་བྱེད་པའི་སྐབས། ཁྱད་པར་བའི་ཆོག་མཆན་འོག་སྟེགས་བུའི་འགྲོ་གྲོན་བརྒྱ་ཆ་༡༠ དང་། ཁྱད་པར་མེད་པའི་ཆོག་མཆན་འོག་བརྒྱ་ཆ་༣༠ ཡིན།",
  "landing.faq.ai.q": "ངས་ AI སྤྱོད་དགོས་སམ།",
  "landing.faq.ai.a": "མི་དགོས། རོགས་པ་བྱེད་པ་དེ་གདམ་ཁ་ཡིན་ཞིང་ཁྱེད་ཀྱི་སྒྲུང་དང་འཇིག་རྟེན་གྱི་སྐོར་གྱི་དྲི་བ་ལ་ལན་འདེབས། AI ཡིས་བཟོས་པའི་ལས་ཀ་ལ་རྟགས་ཡོད། ཀློག་མཁན་གྱིས་དེ་སྦས་ཐུབ། AI འཚོལ་ཆས་ཀྱིས་ཁྱེད་ཀྱི་ལས་ཀ་ལས་སློབ་ཆོག་མིན་ཁྱེད་ཀྱིས་གཏན་འབེབས།",
  "landing.faq.languages.q": "ངས་སྐད་ཡིག་གཅིག་ལས་མང་བའི་པར་སྐྲུན་བྱེད་ཐུབ་བམ།",
  "landing.faq.languages.a": "ཐུབ། མ་ཡིག་དང་ཟུང་འབྲེལ་དུ་སྒྱུར། སྒྱུར་མཁན་བོས། སྐད་ཡིག་རེ་རེ་རང་གི་རིན་གོང་ལྟར་ཚོང་འདོན་བྱོས།",
  "landing.faq.formats.q": "ངས་རི་མོའི་སྒྲུང་ངམ་སྒྲ་དཔེ་བཟོ་ཐུབ་བམ།",
  "landing.faq.formats.a": "ཐུབ། ནུབ་ཕྱོགས་ཀྱི་རི་མོའི་སྒྲུང་། མངའ་ག་ཡང་ན་ཝེབ་ཊུན་བསྐྲུན། ཡང་ན་ལེའུ་རེ་རེར་སྒྲ་སྣོན། ཚོགས་ཀྱི་ལས་འགན་དང་ཡོང་འབབ་བགོ་བཤའ་ནང་འདུས་ཡོད།"
}
