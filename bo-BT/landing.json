  "landing.journey.summit.caption": "འཇིག་རྟེན་རེ་རེ་ནི་བསམ་པ་ཞིག་ནས་འགོ་འཛུགས།",
  "landing.journey.cta": "ཁྱེད་ཀྱི་འཇིག་རྟེན་བཟོ་འགོ་ཚུགས།",
  "landing.journey.universe.title": "འཇིག་རྟེན་བཟོ།",
  "landing.journey.universe.body": "མི་སྣ་དང་ས་ཆ། ཚོགས་ཁག་དང་ལོ་རྒྱུས། མཐུ་ནུས་དང་ལག་རྩལ་ཚང་མ་ཤེས་བྱ་མཛོད་གཅིག་ཏུ་བསྡུས། ནང་དོན་རྣམས་ཕན་ཚུན་སྦྲེལ། གྲལ་རིས་སུ་བྲིས། རང་ཉིད་ཀྱི་ལོ་ཐོ་གསར་སྐྲུན་བྱོས།",
  "landing.journey.stories.title": "སྒྲུང་བསྐྲུན།",
  "landing.journey.stories.body": "རང་བསྐྱར་ཉར་ཚགས་དང་ཞུ་དག་ལོ་རྒྱུས། དྲ་མེད་ཡིག་རྩོམ་ཡོད་པའི་ཞུ་དག་ཆེན་པོའི་ནང་ལེའུ་འབྲི། གསར་སྤེལ་དུས་བཀག་བྱས་ནས་སྒྲུང་དང་རི་མོའི་སྒྲུང་། སྒྲ་དཔེ་པར་སྐྲུན།",
  "landing.journey.lore.title": "ཤེས་བྱ་མཛོད་དང་སྒྲུང་སྦྲེལ།",
  "landing.journey.lore.body": "ཡིག་ཆའི་ནང་གི་མིང་ཞིག་ཤེས་བྱ་མཛོད་ཀྱི་དེའི་ནང་དོན་ལ་སྦྲེལ། ཀློག་མཁན་གྱིས་ལེའུ་ལས་མ་ཐོན་བར་དུ་དེ་ཕྱེ་ཐུབ། སྒྲུང་གིས་གསལ་བཤད་མ་བྱས་བར་དུ་དོན་དངོས་སྦས་ཐུབ།",
  "landing.journey.audience.title": "ཀློག་མཁན་མང་དུ་འཕེལ།",
  "landing.journey.audience.body": "རྩོམ་པ་པོའི་སྐོར་གསལ་བཤད་དང་ཟིན་བྲིས། ཚོགས་གླེང་དང་ཕ་རོལ་པའི་ཚོགས་པ། གླེང་མོལ་གྱི་བར་སྟོང་རྣམས་བརྒྱུད་ནས་ཀློག་མཁན་གྱི་ཚོགས་སྡེ་བསྐྲུན།",
  "landing.journey.collaborate.title": "གཞན་དང་མཉམ་ལས།",
  "landing.journey.collaborate.body": "རྩོམ་པ་པོ་མཉམ་ལས་པ། བརྟ་དྲེར། སྒྱུར་མཁན་དང་རི་མོ་བྲིས་མཁན་རྣམས་བོས། ཡིག་རྩོམ་མཉམ་སྤྱོད་བྱ། ཞུ་དག་ལ་བསམ་ཚུལ་འགོད། སྒྲུང་ལ་ལས་ཀ་བྱས་པའི་མི་ཚང་མར་ཁྱད་ཆོས་སྤྲོད།",
  "landing.journey.monetize.title": "ཁྱེད་ཀྱི་ལས་ཀ་ནས་ཁྱེད་ཀྱི་ཡོང་འབབ་བསྐྲུན།",
  "landing.journey.monetize.body": "ལེའུ། སྒྲུང་གི་འབྲེལ་རིམ། ཡང་ན་དཔེ་ཆ་ཧྲིལ་པོ་ཚོང་འདོན། རྒྱབ་སྐྱོར་ཐོབ་པའི་དངུལ་ཐོའི་ནང་རིན་གོང་གཏན་འབེབས། ཁ་འབྱེད་ལེའུ་རྣམས་རིན་མེད་དུ་འཇོག། ཚོང་འདོན་རེ་རེའི་ནང་ནས་བརྒྱ་ཆ་༧༠ ནས་༩༠ འཛིན།",
  "landing.readers.eyebrow": "ཀློག་མཁན་རྣམས་ཀྱི་ཆེད།",
