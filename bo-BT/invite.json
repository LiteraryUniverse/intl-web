  "invite.reader.note": "སྒྲུང་གཅིག་ནས་འགོ་འཛུགས།",
  "invite.reader.noteEm": "འཇིག་རྟེན་དེ་ཡང་མཉམ་དུ་ཡོང་།",
  "invite.reader.faq1Q": "ཀློག་པར་ངས་དངུལ་སྤྲོད་དགོས་སམ།",
  "invite.reader.faq1A": "མི་དགོས། ཐོ་ཁོངས་རིན་མེད་ཡིན་ཞིང་། རྩོམ་པ་པོས་སྒྲུང་གང་རིན་མེད་དང་གང་ཚོང་འདོན་ཡིན་པ་གཏན་འབེབས། ཁྱེད་ཀྱིས་སྒྲུང་ཞིག་ལ་དགའ་ན་ལེའུ་ཉོ་བའམ་དེའི་ཕ་རོལ་པའི་ཚོགས་ལ་ཞུགས་ནས་རྩོམ་པ་པོ་ལ་རྒྱབ་སྐྱོར་བྱེད་ཐུབ།",
  "invite.reader.faq2Q": "འཇིག་རྟེན་ཞེས་པ་ཅི་ཡིན།",
  "invite.reader.faq2A": "སྒྲུང་ཞིག་གནས་པའི་འཇིག་རྟེན། དེའི་རྩོམ་པ་པོས་ཤེས་བྱ་མཛོད་ནང་མི་སྣ། ས་ཆ་དང་ལོ་རྒྱུས་འབྲི། སྒྲུང་མང་པོས་འཇིག་རྟེན་གཅིག་མཉམ་སྤྱོད་བྱེད་ཐུབ།",
  "invite.reader.faq3Q": "Explorer འཆར་གཞིས་ཅི་སྣོན།",
  "invite.reader.faq3A": "ཀློག་ཐོ། སྒྲུང་དང་འཇིག་རྟེན་རྣམས་ཀྱི་སྒེར་གྱི་ཟིན་བྲིས། རྩོམ་པའི་སྦྱོང་བརྡར། སྤྱོད་མཁན་གྱི་ཚོགས་པ་དང་ཁྱད་ཆོས་གསར་པའི་འདེམས་འཐུ།",
  "invite.reader.faq4Q": "ངས་ཀྱང་འབྲི་ཐུབ་བམ།",
  "invite.reader.faq4A": "ནམ་ཡིན་ཀྱང་། ཐོ་ཁོངས་གཅིག་པུས་ཁྱེད་རང་ཉིད་ཀྱི་སྒྲུང་གི་ལས་ཁང་ཕྱེ། རིན་མེད་འཆར་གཞིས་དེ་ཁྱབ།",
  "invite.reader.closingTitle": "ཁྱེད་ཀྱི་རྗེས་མའི་",
  "invite.reader.closingTitleEm": "དགའ་ཤོས་ཀྱི་འཇིག་རྟེན་འཚོལ།",
  "invite.reader.closingBody": "ཐོ་ཁོངས་ཤིག་བཟོས། ཁྱེད་དགའ་བའི་སྒྲུང་ལ་རྗེས་འབྲང་བྱོས། དེ་དག་གི་རྒྱབ་ཀྱི་འཇིག་རྟེན་ཞིབ་འཇུག་བྱོས།",
  "invite.reader.ctaGuest": "རིན་མེད་ཀློག་འགོ་ཚུགས།",
