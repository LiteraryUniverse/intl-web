  "landing.journey.eyebrow": "གསར་བསྐྲུན། འབྲེལ་མཐུད། འཕེལ་རྒྱས།",
  "landing.journey.title.lead": "ཡིག་རྩོམ་གྱི་ལམ་ཐག་ཧྲིལ་པོའི་ཆེད་དུ་སྟེགས་བུ་གཅིག་པུ།",
  "landing.journey.title.em": "།",
  "landing.journey.intro": "སྒྲུང་འབྲི་བ་ནི་འགོ་འཛུགས་ཙམ་ཡིན། Literary Universe གིས་རྩོམ་པ་པོ་རྣམས་ལ་རང་གི་སྒྲུང་མཐའ་འཁོར་གྱི་འཇིག་རྟེན་བཟོ་བ་དང་། ཀློག་མཁན་དང་འབྲེལ་བ་བྱེད་པ། གསར་སྐྲུན་ལས་ཀ་ལ་རིང་ཐུང་གི་རྩོམ་པ་པོའི་ཐོན་སྐྱེད་ཀྱི་གནས་ཚུལ་དུ་བསྒྱུར་བར་རོགས་པ་བྱེད།",
