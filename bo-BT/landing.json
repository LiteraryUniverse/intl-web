  "landing.readers.connected.body": "སྒྲུང་ཞིག་གིས་ཤེས་བྱ་མཛོད་ཀྱི་ནང་དོན་ལ་སྦྲེལ་བའི་སྐབས། ལེའུ་ལས་མ་ཐོན་བར་དུ་མི་སྣ་དང་ས་ཆ། ཚོགས་ཁག་དང་ལོ་རྒྱུས་བལྟ་ཐུབ། ཞིབ་ཕྲ་རྣམས་སྒྲུང་མཇུག་མི་ཤར་བའི་ཆེད་བསྲུངས་ཡོད། ནང་དོན་ཞིག་གིས་ཁྱེད་ཀྱིས་དེ་གསལ་བཤད་བྱེད་པའི་ལེའུ་ལ་མ་སླེབས་བར་དུ་དོན་དངོས་བཟུང་ཐུབ།",
  "landing.readers.discovery.title": "སྒྲུང་འཚོལ་འཚོལ།",
  "landing.readers.discovery.body": "རིགས་དང་འཇིག་རྟེན། རྩོམ་པ་པོ། སྐད་ཡིག ན་ཚོད་ཀྱི་རིམ་པ་དང་ཆོག་མཆན་ལྟར་སྒྲུང་འཚོལ། གྲོས་འཆར་རྣམས་སྒེར་གྱི་དང་ཚོགས་པའི། དུས་ཚོད་ལྟར་ཡིན་ཐུབ། AI ཡིས་བཟོས་པའི་སྒྲུང་སྦས་ཐུབ།",
  "landing.readers.notes.title": "ཀློག་མཁན་གྱི་ཟིན་བྲིས།",
  "landing.readers.notes.body": "སྒྲུང་དང་ལེའུ། ཤེས་བྱ་མཛོད་ཀྱི་ནང་དོན་རྣམས་ལ་སྒེར་གྱི་ཟིན་བྲིས་ཉར། དེ་ཐམས་ཅད་འཚོལ་ཐུབ་པའི་ཟིན་བྲིས་དཔེ་མཛོད་གཅིག་ཏུ་འཛུལ།",
  "landing.readers.pages.title": "འཇིག་རྟེན་ཤོག་ངོས།",
  "landing.readers.pages.body": "འཇིག་རྟེན་རེ་རེར་སྤྱི་སྤྱོད་ཀྱི་ཤོག་ངོས་ཡོད། དེའི་ནང་སྒྲུང་དང་རི་མོའི་སྒྲུང་། ཤེས་བྱ་མཛོད། མཉམ་ལས་པ་དང་ཚོགས་གླེང་ཡོད།",
  "landing.readers.lists.title": "ཀློག་ཐོ།",
  "landing.readers.lists.body": "སྒྲུང་ཉར། སྤྱི་ལ་ཡང་ན་སྒེར་ལ་ཀློག་ཐོ་བཟོས། ཁྱེད་མཚམས་བཞག་སའི་ཁུངས་ནས་མུ་མཐུད། ཁྱེད་ཀྱི་དཔེ་མཛོད་ལ་ཚད་གསུམ་གྱི་དཔེ་སྒམ་ཡང་ཡོད།",
  "landing.readers.community.title": "སྒྲུང་མཐའ་འཁོར་གྱི་ཚོགས་པ།",
  "landing.readers.community.body": "ལེའུ་ལ་བསམ་ཚུལ་འགོད། འཇིག་རྟེན་མཐའ་འཁོར་གྱི་ཚོགས་གླེང་ལ་ཞུགས། རྩོམ་པ་པོ་དང་དེ་དག་གི་ཟིན་བྲིས་ལ་རྗེས་འབྲང་། ཚོགས་པ་དང་འདུ་འཛོམས་སུ་ཕ་རོལ་པ་གཞན་དང་ཐུག།",
  "landing.authors.eyebrow": "ཁྱེད་ཀྱི་ལས་ཀ། ཁྱེད་ཀྱི་འཇིག་རྟེན། ཁྱེད་ཀྱི་ཀློག་མཁན།",
  "landing.authors.title.lead": "ཁྱེད་ཀྱི་རྩོམ་པ་པོའི་ཐོན་སྐྱེད་བསྐྲུན།",
  "landing.authors.title.em": "སྒྲུང་གཅིག་ལས་ལྷག་པ།",
  "landing.authors.intro": "Literary Universe གིས་རྩོམ་པ་པོ་རྣམས་ལ་རང་གི་ལས་ཀ་དང་འཇིག་རྟེན། ཀློག་མཁན་གྱི་ཆེད་དུ་རིང་ཐུང་གི་ཁྱིམ་ཞིག་བསྐྲུན་པར་རོགས་པ་བྱེད།",
  "landing.authors.profile.title": "རྩོམ་པ་པོའི་ཁྱད་ཆོས་ཤོག་ངོས།",
  "landing.authors.profile.body": "ཁྱེད་ཀྱི་ལས་ཀ། ཕྱི་ཚད་དང་བྱ་འགུལ་ཅན་གྱི་སྤྱི་སྤྱོད་ཤོག་ངོས། དེ་ལས་ར་སྤྲོད་ཀྱི་ཚད་རྟགས། ཁྱད་ཆོས་ཐོ་བཟོས་ནས་པར་སྐྲུན་པ་དང་སྒེར་སྦྲེལ་ཐག་ལ་བརྟེན་ནས་བརྒྱུད།",
  "landing.authors.fanClubs.title": "ཕ་རོལ་པའི་ཚོགས།",
  "landing.authors.fanClubs.body": "ཁྱད་ཆོས་ཅན་གྱི་འདུ་ཁྱབ་རིམ་པ་སྤྲོད། ཚོགས་མི་རྣམས་ལ་ལེའུ་གསར་པ་སྔོན་དུ་ཐོབ་པ་དང་། སྒྲུང་ལ་འཇུག་ཐུབ་པའི་ཆེད་དུ་རྗེས་སུ་གཟིགས་ཐུབ།",
  "landing.authors.forums.title": "ཚོགས་གླེང་།",
  "landing.authors.forums.body": "ཁྱེད་ཀྱི་འཇིག་རྟེན་ལ་ཚོགས་གླེང་ཕྱེ། རིགས་ཁག དབང་ཆའི་སྒྲིག་ཁྲིམས་དང་ལེའུ་གསར་པ་རེ་རེ་དང་ལྷན་དུ་རང་བྱུང་དུ་འགོ་ཚུགས་པའི་གླེང་མོལ་ཡོད།",
  "landing.authors.groups.title": "ཚོགས་པ།",
  "landing.authors.groups.body": "རིགས། རྩོམ་པའི་དགའ་ཚོར། ཕ་རོལ་པ་དང་གསར་སྐྲུན་ལས་འཆར་ཞིག་མཐའ་འཁོར་གྱི་ཚོགས་སྡེ་བཟོ་བའམ་ཞུགས།",
  "landing.authors.organizations.title": "ཚོགས་སྡེ།",
  "landing.authors.organizations.body": "པར་སྐྲུན་པ། རྩོམ་པའི་ཚོགས་པ། སློབ་གྲྭ་དང་རུ་ཁག་རྣམས་ལ་མཉམ་སྤྱོད་ཀྱི་ལས་ཁང་། ཚོགས་མིའི་གནས་ཆ། སློབ་ཚན་དང་རང་ཉིད་ཀྱི་ཕ་རོལ་པའི་ཚོགས་པ་ཡོད།",
  "landing.authors.statistics.title": "ཐོ་གཞུང་།",
  "landing.authors.statistics.body": "སུས་ཀློག་གི་ཡོད། ག་བར་ཕྱིན་གྱི་ཡོད་དང་། ཁྱེད་ལ་ཇི་ལྟར་རྙེད་པ་བལྟོས། ལེའུ་ལྟར། སྐད་ཡིག་ལྟར། གཟའ་འཁོར་གྱི་ཉིན་ལྟར་དབྱེ་བ་བྱེད།",
  "landing.future.eyebrow": "རྗེས་ཀྱི་ཆེད་དུ་བར་སྟོང་།",
  "landing.future.title.lead": "དེ་རིང་གི་རྩོམ་པ་པོའི་ཆེད་དུ་བཟོས།",
  "landing.future.title.em1": "སང་ཉིན་གྱི་པར་སྐྲུན་གྱི་",
  "landing.future.title.em2": "གོ་སྐབས་ཀྱི་ཆེད་གྲ་ཡོད།",
  "landing.future.intro": "པར་སྐྲུན་པ་རྣམས་ལ་སྒེར་ཡིག་ཆའི་སྦྲེལ་ཐག་བརྒྱུད། ཚོང་ཁང་དང་དཔེ་མཛོད་ཀྱི་ཆེད་དུ་ Thema དང་ ONIX ཞིབ་ཕྲ་གྲ་སྒྲིག་བྱ། སྟེགས་བུའི་ཐོག་ནས་ཆོག་མཆན་གྲོས་མཐུན་བྱོས། པར་སྐྲུན་པའི་ལག་ཆ་དང་འགྲེམས་སྤེལ་གྱི་ཐབས་ལམ་ཁ་སྣོན་བྱེད་པའི་རྒྱུན་ལམ་ཡོད།",
  "landing.future.art.alt": "Lunea དང་ Luca མཉམ་དུ་སྒྲུང་གི་འཇིག་རྟེན་ཞིག་བསྐྲུན་བཞིན་པ།",
  "landing.final.eyebrow": "ཁྱེད་ཀྱི་སྒྲུང་ད་ལྟ་ཁོ་ན་འགོ་འཛུགས་བཞིན་པ་ཡིན།",
  "landing.final.title.lead": "ད་རིང་ནས་ཁྱེད་ཀྱི་",
  "landing.final.title.em": "སྒྲུང་འཇིག་རྟེན་བཟོ་འགོ་ཚུགས།",
  "landing.final.intro": "ཁྱེད་ཀྱིས་སྒྲུང་དང་པོ་འབྲི་བཞིན་ཡོད་ཀྱང་། སྒྲུང་རིམ་ཆེན་པོ་འཛིན་སྐྱོང་བྱེད་བཞིན་ཡོད་ཀྱང་། ཞིབ་འཇུག་བྱ་རྒྱུའི་འཇིག་རྟེན་གཞན་འཚོལ་བཞིན་ཡོད་ཀྱང་། Literary Universe གིས་ཁྱེད་ལ་བསྐྲུན་པ། པར་སྐྲུན། ཞིབ་འཚོལ་དང་འཕེལ་རྒྱས་ཀྱི་ས་ཆ་སྤྲོད།",
  "landing.final.banner.alt": "Literary Universe སྒྲུང་གི་འཇིག་རྟེན་རྣམས།",
  "landing.final.buildCta": "ཁྱེད་ཀྱི་འཇིག་རྟེན་བཟོ་འགོ་ཚུགས།",
  "landing.final.exploreCta": "སྒྲུང་རྣམས་ཞིབ་འཇུག་བྱོས།",
  "landing.formats.eyebrow": "ཡིག་རྩོམ་ལས་ལྷག་པ།",
  "landing.formats.title.lead": "རྣམ་པ་གང་ཡིན་དང་",
  "landing.formats.title.em": "སྐད་ཡིག་གང་ཡིན་ནས་བཤད།",
  "landing.formats.intro": "ཡིག་རྩོམ། མངའ་ག་དང་ཝེབ་ཊུན། སྒྲ་དཔེ་རྣམས་འཇིག་རྟེན་གཅིག་གི་ནང་ཡོད། དེ་དག་གི་སྒྱུར་རྩོམ་རྣམས་ཀྱང་དེ་བཞིན།",
