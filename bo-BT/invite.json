  "invite.reader.ctaTryWriting": "འབྲི་བསྐྱར་ཚོད།",
  "invite.reader.memberUpgrade": "ཁྱེད་སྔར་ནས་ཚོགས་མི་ཡིན། Explorer འཆར་གཞིས་ཀློག་ཐོ། སྒྲུང་དང་འཇིག་རྟེན་རྣམས་ཀྱི་སྒེར་གྱི་ཟིན་བྲིས། རྩོམ་པའི་སྦྱོང་བརྡར་དང་སྤྱོད་མཁན་གྱི་ཚོགས་པ་སྣོན།",
  "invite.reader.memberThanks": "Literary Universe ལ་རྒྱབ་སྐྱོར་བྱས་པར་ཐུགས་རྗེ་ཆེ། རང་ཉིད་ཀྱི་སྒྲུང་འབྲི་རྒྱུའི་སྐོར་བསམ་མྱོང་ཡོད་དམ། ཁྱེད་ཀྱི་རྩིས་ཐོར་ལས་ཁང་ཞིག་སྔར་ནས་ཡོད།",
  "invite.author.seoTitle": "ཁྱེད་ཀྱི་པར་སྐྲུན་བྱས་པའི་དཔེ་ཆ་ Literary Universe ལ་ཁྱེར།",
  "invite.author.seoDescription": "ཀློག་མཁན་གསར་པ་ལ་སླེབས། ཁྱེད་ཀྱི་དཔེ་ཆའི་མཐའ་འཁོར་ལ་ཚོགས་སྡེ་བསྐྲུན། ཚོང་འདོན་རེ་རེའི་ནང་ནས་བརྒྱ་ཆ་༧༠ ནས་༩༠ འཛིན། ཁྱེད་ཀྱི་དབང་ཆ་ཁྱེད་རང་ལ་ཉར་ཞིང་བཀག་འཛིན་མེད།",
