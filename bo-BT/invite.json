  "invite.author.stripMessage": "ཁྱེད་ཀྱིས་ Literary Universe ལ་ཚོང་འདོན་བྱ་འདོད་པའི་པར་སྐྲུན་བྱས་པའི་ལས་ཀ་ཡོད་དམ།",
  "invite.author.featuresTitle": "ཁྱིམ་གསར་པ།",
  "invite.author.featuresTitleEm": "ཁྱེད་ཀྱིས་པར་དུ་བསྐྲུན་ཟིན་པའི་དཔེ་ཆའི་ཆེད་དུ།",
  "invite.author.featuresIntro": "ཁྱེད་ཀྱིས་འདེམས་མེད་ན་ཁྱད་པར་བ་མེད། ཁྱེད་ཀྱི་ཚོང་འདོན་གྲངས་ཐོ་ཁྱེད་ལ་ཁ་ཕྱེ་ཡོད། ཁྱེད་ཀྱི་ལས་ཀ་ཁྱེད་འདོད་པའི་ཚེ་ EPUB དུ་ཕྱིར་འདོན་བྱེད།",
  "invite.author.feature1Title": "ཀློག་མཁན་གསར་པ་ལ་སླེབས།",
  "invite.author.feature1Body": "ཁྱེད་ཀྱི་འཇིག་རྟེན་ཤོག་ངོས་དང་དེའི་ཤེས་བྱ་མཛོད་ཀྱིས་ཀློག་མཁན་གསར་པ་ལ་ཁྱེད་ཀྱི་དཔེ་ཆར་འཛུལ་ཐབས་སྤྲོད། འཚོལ་ཞིབ་ཀྱིས་དེ་དག་ལ་ཁྱེད་རྙེད་པར་རོགས་པ་བྱེད།",
  "invite.author.feature2Title": "ཚོགས་སྡེ་བསྐྲུན།",
  "invite.author.feature2Body": "ཁྱད་ཆོས་ཅན་དང་སྔོན་དུ་ཐོབ་པའི་ལེའུ་དང་བཅས་པའི་ཕ་རོལ་པའི་ཚོགས། ཟིན་བྲིས་དང་ཚོགས་གླེང་གིས་དཔེ་ཆའི་བར་དུ་ཁྱེད་ཀྱི་ཀློག་མཁན་ཉེ་བར་བྱེད།",
  "invite.author.feature3Title": "གྲངས་རེ་རེ་བལྟོས།",
  "invite.author.feature3Body": "ཚོང་འདོན་དང་དངུལ་འབྲེལ་གྱི་གྲངས་ཐོ་ཁྱེད་ལ་ཁ་ཕྱེ་ཡོད། ཁྱད་པར་བའི་ཆོག་མཆན་འོག་སྟེགས་བུའི་འགྲོ་གྲོན་བརྒྱ་ཆ་༡༠ དང་། ཁྱད་པར་མེད་པའི་ཆོག་མཆན་འོག་བརྒྱ་ཆ་༣༠ ཡིན།",
  "invite.author.feature4Title": "ཁྱེད་འདོད་པའི་ཚེ་ཐོན།",
  "invite.author.feature4Body": "ཁྱེད་ཀྱིས་དབང་ཆ་དང་ཡིག་ཆ་ཉར། སྒྲུང་ཧྲིལ་པོ་ཡང་ན་འབྲེལ་རིམ་རེ་རེ་ EPUB དུ་ཕྱིར་འདོན་བྱེད། དེས་ན་ཁྱེད་ནམ་ཡང་བཀག་འཛིན་མི་འོང་།",
  "invite.author.note": "ཁྱེད་ཀྱི་དཔེ་ཆས་ཧ་ལམ་ཀློག་མཁན་རྙེད་ཟིན།",
  "invite.author.noteEm": "ད་དུང་ཅུང་ཟད་རྙེད་བྱས་ཤོག",
  "invite.author.faq1Q": "ངས་ཧ་ལམ་པར་སྐྲུན་བྱས་པའི་དཔེ་ཆ་ཚོང་འདོན་བྱེད་ཐུབ་བམ།",
